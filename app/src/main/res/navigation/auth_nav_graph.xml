<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/loginFragment"
    android:id="@+id/auth_nav_graph">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.da1androidnative.ui.auth.LoginFragment">

        <!-- popUp + popUpToInclusive = true // Borra el Login del backstack -->
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/home_nav_graph"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true">
        </action>

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_login_to_otpVerificationFragment"
            app:destination="@id/otpVerificationFragment" />
    </fragment>

   <fragment
      android:id="@+id/registerFragment"
      android:name="com.example.da1androidnative.ui.auth.RegisterFragment"
      android:label="Register">

      <action
        android:id="@+id/action_register_to_home"
        app:destination="@id/home_nav_graph"
        app:popUpTo="@id/auth_nav_graph"
        app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/otpVerificationFragment"
        android:name="com.example.da1androidnative.ui.auth.OtpVerificationFragment"
        android:label="OtpVerification">
        <action
            android:id="@+id/action_otpVerificationFragment_to_home_nav_graph"
            app:destination="@id/home_nav_graph"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
